Each test follows the AAA (Arrange–Act–Assert) pattern:
---------------------------------------
	Arrange → Mock the service using when(...).thenReturn(...).
	Act → Execute the HTTP request using mockMvc.perform(...).		Assert → Verify the expected HTTP status and response body using andExpect(...).

	 // =============================
	 // GET ALL USERS - Positive Test
	 // =============================
	 @Test
	 void testGetAllUsers_ReturnsUsers() throws Exception {
	
	     // Mock service with list of users
	     when(service.findAllUsers())
	             .thenReturn(Arrays.asList(
	                     	new User(1, "Alice"),
	                     	new User(2, "Bob")
	                     ));
	
	     // Verify:
	     // 1. HTTP Status = 200 OK
	     // 2. Response contains both users
	     mockMvc.perform(get("/users"))
	            .andExpect(status().isOk())
	            .andExpect(jsonPath("$[0].name").value("Alice"))
	            .andExpect(jsonPath("$[1].name").value("Bob"));
	 }


	 // =============================
	 // GET ALL USERS - Negative Test
	 // =============================
	 @Test
	 void testGetAllUsers_NoContent() throws Exception {
	     // Mock empty user list
	     when(service.findAllUsers()).thenReturn(Collections.emptyList());
	
	     // Verify API returns 204 No Content
	     mockMvc.perform(get("/users"))
	            .andExpect(status().isNoContent());
	 }


