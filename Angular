     Data ->  parent.ts   -> child.ts   
1. String -> name = 'Rohit'; 
          -> @Input() name!: string;
2. Number -> age=23; 
          -> @Input() age!:number
3. Boolean-> isLogged=true;
          -> @Input() isLoggedIn!:boolean;
4. Object -> user={name:'Rohit',email:'rohit@gmail.com'}; 
          -> @Input() user@:{name:string,email:string;};
5. Array-> users=['Rohit','Rahul','Amit']; 
        -> @Input() users!:string[];
6. Array of Objects
