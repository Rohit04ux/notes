Employee.java
------------------
class Employee {
    private int id;
    private String name;
    private String department;
    private int salary;

    public Employee(int id, String name, String department, int salary) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.salary = salary;
    }

   /*------------------getter and setters--------*/

    @Override
    public String toString() {
        return id + " " + name + " " + department + " " + salary;
    }
}


