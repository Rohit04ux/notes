class Student {
    int id;
    String name;

    Student() { ----> Default constructor using this()
        this(101, "John");-----> Calls parameterized constructor
    }
 
    Student(int id, String name) { -----> Parameterized constructor
        this.id = id;----------> this.variable refers to instance variable
        this.name = name;------> this.variable refers to instance variable
    }

    void display() {  ------------> Method using this.method()
        this.showDetails();  -----> Calls current object's method
    }

    void showDetails() {
        System.out.println("ID: " + this.id);
        System.out.println("Name: " + this.name);
    }

    public static void main(String[] args) {
        Student s = new Student(); -----> Creates object
        s.display();
    }
}

